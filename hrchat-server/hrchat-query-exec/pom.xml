    <properties>
        <jacoco.line.minimum>0.80</jacoco.line.minimum>
    </properties>
    <dependencies>
        <dependency>
            <groupId>com.hrchat</groupId>
            <artifactId>hrchat-api</artifactId>
            <version>${project.version}</version>
        </dependency>
