# Copy to .env.local in this directory. Never commit a real API Key.
# These settings are used by the S2 one-call probe and isolated launcher.
# General Model Studio (Beijing) Key: sk-... with the URL below.
# A plan-specific sk-sp-... Key requires its own Base URL and supported model.
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen-turbo
OPENAI_API_KEY=
