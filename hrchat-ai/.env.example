# Copy to .env.local in this directory. Never commit a real API Key.
# Used by uvicorn (agent_gateway), S2 probe, and isolated launcher.
# General Model Studio (Beijing) Key: sk-... with the URL below.
# A plan-specific sk-sp-... Key requires its own Base URL and supported model.
# LLM_PROFILE=openai enables model QueryPlan; omit it to auto-select openai when API_KEY is set.
LLM_PROFILE=openai
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen-plus
OPENAI_API_KEY=
# S4: at most one constrained repair. Set 0 for a no-repair comparison.
HRCHAT_QUERY_REPAIR_ENABLED=1
# Local CPU retrieval: hybrid (BGE + BM25/RRF), lexical (comparison), off (baseline).
# Download once with: python -m adapters.prepare_embedding
HRCHAT_RAG_MODE=hybrid
# Optional model directory; default: hrchat-ai/.models/bge-small-zh-v1.5
# HRCHAT_EMBEDDING_DIR=
